# Accounts frontend as its own app: the tabs served by nginx, with /config.js
# and the /api/ proxy. Used where the frontend runs apart from the API - the
# cloud rehearsal (docker-compose.cloud.yml) and Azure Container Apps. Plain
# Compose keeps serving the tabs from frontend/server.py inside the accounts
# image (run.py), so it serves the same paths: / (Normal), /ai-mode, /tabs/*,
# /css/*, /js/*.
# Build context: repository root
#   docker build -f services/accounts/frontend/Dockerfile.web -t smartbank-accounts-web:0.1 .
FROM nginx:alpine

COPY shared/frontend/css/ /usr/share/nginx/html/css/
COPY shared/frontend/js/ /usr/share/nginx/html/js/
COPY services/accounts/frontend/tabs/ /usr/share/nginx/html/tabs/
COPY services/accounts/frontend/tabs/normal.html /usr/share/nginx/html/index.html
COPY services/accounts/frontend/tabs/ai-mode.html /usr/share/nginx/html/ai-mode.html

COPY deploy/nginx/feature.conf.template /etc/nginx/templates/default.conf.template
ENV SMARTBANK_SAME_ORIGIN_API=false \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 \
    API_UPSTREAM=http://accounts:5001

EXPOSE 80
