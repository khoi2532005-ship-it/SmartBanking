# SmartBank - Release 0 environment template
# Copy to .env and fill in your key:
#   cp .env.example .env
#
# .env is gitignored. NEVER commit a real API key.

# =============================================================================
# AI PROVIDER
# =============================================================================
# Both providers speak the OpenAI chat-completions protocol, so the same client
# code drives either one. Switch with LLM_PROVIDER and nothing else changes.
#
#   gemini  -> Google AI Studio free tier (day-to-day development)
#   ollama  -> local models (required by the Assessment 1 AI-Mode rubric)
#
LLM_PROVIDER=gemini

# ------------------------------------------------------------------- Gemini
# Free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_REVIEW_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------- Ollama
# Local `python` runs use localhost; docker-compose.yml overrides the container
# value to host.docker.internal automatically.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_REVIEW_MODEL=llama3.1:8b

# =============================================================================
# CROSS-SERVICE URLS (local `python` runs)
# =============================================================================
# Inside Compose these resolve by container name instead - see docker-compose.yml.
ACCOUNTS_SERVICE_URL=http://localhost:5001
LOANS_SERVICE_URL=http://localhost:5002
FRAUD_SERVICE_URL=http://localhost:5003
BUDGET_SERVICE_URL=http://localhost:5004
# Agentic loop, budgeting mode: which customer and period to inspect. Defaults
# to customer 1 and the current month; when that month has no budgets the mode
# uses the customer's most recent budget period (the seed is September 2026)
# and says so in the evidence. Set MONTH and YEAR to pin a period instead.
# BUDGET_LOOP_CUSTOMER=1
# BUDGET_LOOP_MONTH=9
# BUDGET_LOOP_YEAR=2026
TRANSACTIONS_SERVICE_URL=http://localhost:5005

ACCOUNTS_DB_URL=http://localhost:5011
LOANS_DB_URL=http://localhost:5012
FRAUD_DB_URL=http://localhost:5013
BUDGET_DB_URL=http://localhost:5014
TRANSACTIONS_DB_URL=http://localhost:5015

# =============================================================================
# RELEASE 1 - SHARED LOCAL MCP AND RAG SERVERS
# =============================================================================
# Both run on the host (python -m mcp_server.server / python -m rag_server.server),
# never as Compose services. Every value has a default; they are listed so the
# knobs are discoverable.
MCP_HOST=0.0.0.0
MCP_PORT=8100
MCP_LOG_LEVEL=WARNING
# Feature frontends expose MCP (MCP Mode) and RAG (RAG Mode) tabs that proxy
# through their backend. Set either to false to disable that mode app-wide;
# the per-request X-MCP-Mode / X-RAG-Mode headers still gate individual calls.
MCP_ENABLED=true
RAG_ENABLED=true
# Release 2: AI-Mode (a backend's own LLM calls, e.g. fraud's alert
# explanations) has the same kind of switch. CI and the cloud baseline set it
# to false; /api/health reports it.
AI_MODE_ENABLED=true
# Where clients (feature backends, the agentic loop, the validate script) find
# the MCP server. Compose points containers at http://host.docker.internal:8100/mcp.
MCP_SERVER_URL=http://localhost:8100/mcp
MCP_CLIENT_TIMEOUT=15

RAG_HOST=0.0.0.0
RAG_PORT=8200
# Compose points containers at http://host.docker.internal:8200.
RAG_SERVER_URL=http://localhost:8200

# Release 2: shared Multi-Agent Server (python -m multi_agent_server.server).
# MULTI_AGENT_ENABLED and MULTI_AGENT_SERVER_URL are for the feature backends,
# exactly like MCP_ENABLED and RAG_ENABLED, and are not read by the server
# (budgeting is wired in the next PR; the other backends copy the same client).
# false keeps a backend's Multi-Agent panel in place but makes every call
# answer "inactive"; the server itself is started and stopped by hand.
# Containers reach the server at http://host.docker.internal:8300.
MULTI_AGENT_ENABLED=true
MULTI_AGENT_SERVER_URL=http://localhost:8300
MULTI_AGENT_HOST=0.0.0.0
MULTI_AGENT_PORT=8300
# Optional shared secret. When set, the server requires "Authorization: Bearer
# <token>" on every /workflow route and the backends, terminal runners and
# validate script send it. Leave empty for an open local demo.
MULTI_AGENT_API_TOKEN=
# Bounded execution: seconds a Planner/Worker/Reviewer stage may take, and how
# many times the Reviewer may send the Worker back before the human decides.
MULTI_AGENT_STAGE_TIMEOUT=60
MULTI_AGENT_MAX_REVISIONS=1
# Runtime audit files (workflow_history.jsonl, coordination_audit.jsonl) go under
# multi_agent_server/data/audit; `python -m multi_agent_server.validate --evidence`
# snapshots them into docs/evidence/multi_agent/.
# MULTI_AGENT_AUDIT_DIR=multi_agent_server/data/audit
# Optional per-role model overrides (unset = the shared AI-Mode model):
# MULTI_AGENT_PLANNER_MODEL=
# MULTI_AGENT_WORKER_MODEL=
# MULTI_AGENT_REVIEWER_MODEL=
# Minimum IDF-weighted overlap (0-1) between a question and a chunk for the
# chunk to count as evidence. Below it the RAG server answers "insufficient
# context" and spends no tokens. Raise to be stricter, lower to answer more.
RAG_RELEVANCE_THRESHOLD=0.35
RAG_MAX_ANSWER_TOKENS=700

# =============================================================================
# RUNTIME
# =============================================================================
FLASK_OPEN_CHROME=0

# Fraud Alerts detection reads transactions from a local seed fixture by
# default. Set to `http` once a real Transactions service exists - it will
# fall back to the seed automatically if that service is unreachable.
TRANSACTIONS_SOURCE=seed

# Browsers may call budgeting-service only from its own tab (port 3004) or the
# home page (port 3000) on the same host as the API. Add other page origins
# here, comma-separated, e.g. a proxied cloud frontend; docker-compose.yml
# passes this to budgeting-service.
# BUDGET_FRONTEND_ORIGINS=

# Browsers may call fraud-service only from its own tab (port 3003 on the same
# host as the API). Add other page origins here, comma-separated, e.g. a
# proxied cloud frontend; docker-compose.yml passes this to fraud-service.
# FRAUD_FRONTEND_ORIGINS=
